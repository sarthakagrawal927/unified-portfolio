{
  "name": "unified-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vinext dev --port 3040",
    "build": "vinext build",
    "start": "next start --hostname 127.0.0.1 --port 3040",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "wrangler d1 migrations apply unified-portfolio --remote",
    "jobs": "wrangler dev --config dist/server/wrangler.json --test-scheduled",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --tag \"$(git rev-parse HEAD)\"",
    "db:migrate:local": "wrangler d1 migrations apply unified-portfolio --local",
    "dev:next": "next dev --hostname 127.0.0.1 --port 3042",
    "build:next": "next build",
    "deploy": "wrangler deploy --config dist/server/wrangler.json --tag \"$(git rev-parse HEAD)\""
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
