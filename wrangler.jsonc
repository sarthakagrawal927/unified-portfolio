{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unified-portfolio",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "account_id": "7d048325699a5acddb44d3be31cf6ba9",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unified-portfolio",
      "database_id": "bd1a2b65-7ab1-4ded-93f4-bfb2c3ca127f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://money.significanthobbies.com"
  },
  "routes": [
    {
      "pattern": "money.significanthobbies.com",
      "custom_domain": true
    }
  ]
}
